# Keep source files consistent across Windows and Unix.
*.html text eol=lf
*.md text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Preserve documents and images as binary assets.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
